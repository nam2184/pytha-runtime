{
  "name": "pytha-runtime",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:runtime\" \"npm run dev:client\"",
    "dev:runtime": "tsx watch runtime/index.ts",
    "dev:client": "vite",
    "mcp": "node.exe --import tsx runtime/mcp.ts",
    "mcp:http": "node.exe --import tsx runtime/mcp_http.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.runtime.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fengari": "^0.1.5",
    "jszip": "^3.10.1",
    "three": "^0.162.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.11.0",
    "@types/three": "^0.162.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
